{
  "name": "arkfeets",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c green,cyan \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w server && npm run build -w web",
    "test": "npm run test -w server",
    "start": "npm run start -w server",
    "package:win": "npm run build && node scripts/build-portable.mjs"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "bun": "^1.4.3",
    "concurrently": "^9.2.1"
  }
}
